X-API-KEY: {{tokenFerreteria}}
Content-Type: application/json

{
  "formato": "ferreteria",
  "client_id": 999999999,
  "items": [ { "description": "CORTE DE TUBO", "quantity": 1, "amount": 150 } ]
}

